
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
(() => {
  const SUPABASE_URL = "PASTE_YOUR_PROJECT_URL";
  const SUPABASE_PUBLISHABLE_KEY = "PASTE_YOUR_PUBLISHABLE_KEY";

  const status = document.getElementById("vt-status");
  const signupForm = document.getElementById("vt-signup");
  const loginForm = document.getElementById("vt-login");
  const dashboard = document.getElementById("vt-dashboard");
  const userEmail = document.getElementById("vt-user-email");

  if (!window.supabase ||
      SUPABASE_URL.includes("PASTE_") ||
      SUPABASE_PUBLISHABLE_KEY.includes("PASTE_")) {
    status.textContent =
      "Setup incomplete: add your Supabase URL and publishable key.";
    return;
  }

  const client = window.supabase.createClient(
    SUPABASE_URL,
    SUPABASE_PUBLISHABLE_KEY
  );

  function showStatus(message) {
    status.textContent = message;
  }

  function showUser(user) {
    dashboard.hidden = !user;
    userEmail.textContent = user ? user.email || "" : "";
    signupForm.hidden = !!user;
    loginForm.hidden = !!user;
  }

  signupForm.addEventListener("submit", async (event) => {
    event.preventDefault();
    showStatus("Creating your account...");

    const email = document.getElementById("vt-signup-email").value.trim();
    const password = document.getElementById("vt-signup-password").value;

    const { data, error } = await client.auth.signUp({
      email,
      password,
      options: {
        emailRedirectTo: window.location.origin
      }
    });

    if (error) {
      showStatus(error.message);
      return;
    }

    if (data.session) {
      showUser(data.user);
      showStatus("Account created and signed in.");
    } else {
      showStatus("Check your email for the confirmation link before logging in.");
    }
  });

  loginForm.addEventListener("submit", async (event) => {
    event.preventDefault();
    showStatus("Signing you in...");

    const email = document.getElementById("vt-login-email").value.trim();
    const password = document.getElementById("vt-login-password").value;

    const { data, error } = await client.auth.signInWithPassword({
      email,
      password
    });

    if (error) {
      showStatus(error.message);
      return;
    }

    showUser(data.user);
    showStatus("You're signed in.");
  });

  document.getElementById("vt-logout").addEventListener("click", async () => {
    const { error } = await client.auth.signOut();

    if (error) {
      showStatus(error.message);
      return;
    }

    showUser(null);
    showStatus("You've logged out.");
  });

  client.auth.onAuthStateChange((_event, session) => {
    showUser(session?.user ?? null);
  });

  client.auth.getSession().then(({ data, error }) => {
    if (error) {
      showStatus("Could not check your session. Please refresh the page.");
      return;
    }
    showUser(data.session?.user ?? null);
  });
})();
</script>
</body>
